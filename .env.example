# PromiseLoop AI Environment Configuration Template
# Copy this file to .env and configure your desired settings.
# NEVER commit your real .env file or private credentials to source control.

# ==============================================================================
# Generative AI Provider Configuration (Backend only; never exposed to browser)
# ==============================================================================
# Supported providers: groq, openai, openrouter, ollama, or custom
AI_PROVIDER=groq

# Provider API Key (Keep secret! Leave blank for grounded deterministic fallback)
AI_API_KEY=

# Base URL for OpenAI-compatible chat completions API
# Groq:       https://api.groq.com/openai/v1
# OpenAI:     https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# Ollama:     http://localhost:11434/v1
AI_BASE_URL=https://api.groq.com/openai/v1

# Supported model name on your configured provider
# Groq:       llama-3.3-70b-versatile or llama-3.1-8b-instant
# OpenAI:     gpt-4o-mini or gpt-4o
# OpenRouter: meta-llama/llama-3.1-8b-instruct
# Ollama:     llama3
AI_MODEL=llama-3.3-70b-versatile

# ==============================================================================
# Support Staff & Administrator Credentials
# ==============================================================================
# Local Development Support Agent Account (default fallback if not set):
# Email:    agent@promiseloop.local
# Password: SupportDemo2026!
SUPPORT_AGENT_EMAIL=agent@promiseloop.local
SUPPORT_AGENT_PASSWORD=SupportDemo2026!
SUPPORT_AGENT_NAME=Support Agent

# Optional Support Manager Account (Authorized to override priority bands with reason)
# Leave blank to disable manager overrides
SUPPORT_MANAGER_EMAIL=manager@promiseloop.local
SUPPORT_MANAGER_PASSWORD=ManagerDemo2026!
SUPPORT_MANAGER_NAME=Support Manager

# ==============================================================================
# Server & Storage Configuration
# ==============================================================================
PORT=4000
# Optional custom directories for data and uploads (defaults to ./server/data and ./server/private-uploads)
# PROMISELOOP_DATA_DIR=
# PROMISELOOP_UPLOAD_DIR=

# Optional custom approved policy source JSON file path
# POLICY_SOURCE_PATH=

# ==============================================================================
# Deterministic SLA Policies (Target hours by impact category)
# ==============================================================================
# First-response SLA targets (hours)
SLA_FIRST_RESPONSE_HOURS_SAFETY=1
SLA_FIRST_RESPONSE_HOURS_FINANCIAL=8
SLA_FIRST_RESPONSE_HOURS_SERVICE=24
SLA_FIRST_RESPONSE_HOURS_INCONVENIENCE=48

# Final resolution SLA targets (hours)
SLA_RESOLUTION_HOURS_SAFETY=24
SLA_RESOLUTION_HOURS_FINANCIAL=72
SLA_RESOLUTION_HOURS_SERVICE=120
SLA_RESOLUTION_HOURS_INCONVENIENCE=168
